# Copy to .env (never committed). The Taskfile loads it for dev:run, dev:cli and dev:smoke; docker-compose.yaml for the container.

# Empty: the app runs on the FakeLLM, no API call. Set: the real LLM, e.g. openai:gpt-6-luna.
LLM_MODEL=
# Required when LLM_MODEL is set.
OPENAI_API_KEY=
# FakeLLM only: each reply waits this long (ms), to show the chat's typing indicator in a demo.
FAKE_LLM_LATENCY_MS=
# Timeout of each LLM call, in seconds.
LLM_TIMEOUT_SECONDS=15
# 1: adds POST /api/dev/tick, which moves the clock forward and runs the sweep, and POST /api/dev/reset
# with the dashboard Reset button, which deletes every candidate. Never in production.
DEV_ROUTES=
